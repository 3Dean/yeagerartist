{
  "name": "dean-yeager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "dist": "npm run build",
    "check": "astro check",
    "postbuild": "node ./scripts/search/prepare-index.js",
    "preview": "astro preview",
    "check:type": "tsc --project tsconfig.json --pretty --noEmit",
    "lint": "biome lint src",
    "format": "biome format src --write",
    "cz": "cz",
    "deploy": "npm run build && aws s3 sync ./dist s3://yeagerartist/ --delete && aws cloudfront create-invalidation --distribution-id E9L1YNIZMQXZS --paths \"/*\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@aws-amplify/backend": "^1.16.0",
    "@aws-amplify/backend-cli": "^1.7.0",
    "@biomejs/biome": "1.4.1",
    "@fontsource/fira-sans": "^5.0.18",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^18.19.3",
    "astro": "^5.18.0",
    "astro-icon": "^0.8.2",
    "aws-cdk-lib": "^2.189.1",
    "commitizen": "^4.3.0",
    "constructs": "^10.4.2",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.25.3",
    "globby": "^14.0.0",
    "gray-matter": "^4.0.3",
    "lunr": "^2.3.9",
    "mdx": "^0.3.1",
    "remark-code-titles": "^0.1.2",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@astrojs/markdoc": "^0.15.10",
    "@astrojs/svelte": "^7.2.5",
    "@astrojs/vercel": "^9.0.4",
    "@libsql/client": "^0.4.0-pre.5",
    "@tsparticles/engine": "^3.8.1",
    "astro-decap-cms-oauth": "^0.5.1",
    "aws-amplify": "^6.14.4",
    "dotenv": "^16.5.0",
    "ioredis": "^5.3.2",
    "lightgallery": "^2.8.3",
    "svelte": "^5.53.5",
    "tsparticles": "^3.8.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
