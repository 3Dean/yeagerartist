---
// src/components/Hero.astro
---

<section class="relative w-full h-screen overflow-hidden">
  <img
    src="/images/islandbg-5.jpg"
    alt="YeagerArtist Hero"
    class="object-cover w-full h-full absolute inset-0 z-0"
  />
  <div
    class="relative z-10 flex flex-col justify-center items-center h-full text-center text-white px-4"
  >
    <h1 class="text-4xl md:text-6xl font-bold mb-4">
      Worlds Beyond Imagination
    </h1>
    <p class="text-lg md:text-2xl text-gray-300 mb-6">
      3D Artist &#8729 Designer &#8729 Immersive Storyteller
    </p>
    <a
      href="/projects"
      class="bg-theme-primary hover:bg-theme-secondary text-white font-semibold py-3 px-6 rounded-lg shadow-lg transition-all"
    >
      View My Work
    </a>
  </div>
</section>
