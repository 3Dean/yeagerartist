---
export const prerender = true;

import DefaultPageLayout from "$/layouts/default.astro";
import Hero from "../components/Hero.astro";
---

<Hero />

<DefaultPageLayout
  content={{
    title: "Artist, Designer & 3D Environment Creator",
    description:
      "I'm Dean Yeager, a Connecticut-based artist and designer working across visual design, 3D environments, and interactive experiences. I bring ideas to life through concept development, animation, creative technology, and hands-on making.",
  }}
  showPageHeader={false}
>
  <div class="hero">
    <div class="hero__face">
      <div class="author-card">
        <img src="/images/lineart.svg" alt="Dean Yeager" title="Dean Yeager" />
      </div>
    </div>
    <div class="hero__says">
      <p class="text-base md:text-lg text-theme-secondary">
        I&rsquo;m Dean Yeager, a Connecticut-based artist and designer working across
        visual design, 3D environments, and interactive experiences. I bring
        ideas to life through concept development, animation, creative
        technology, and hands-on making.
      </p>
      <section id="contact" class="mt-8">
        <h3 class="text-xl md:text-2xl font-semibold text-theme-primary">
          Have a project in mind?
        </h3>
        <p class="mt-3 text-base md:text-lg text-theme-secondary">
          I welcome conversations about visual design, motion, 3D environments,
          and creative experiences&mdash;from an early concept to a defined
          production brief.
        </p>
      </section>
    </div>
  </div>
</DefaultPageLayout>

<style>
  .hero {
    @apply flex flex-col md:flex-row gap-8 w-full transition-all pb-4;
  }
  .hero__face {
    @apply flex md:flex-none justify-center;
  }
  .hero__says {
    @apply flex-1 text-center md:text-left;
  }
  .author-card {
    @apply h-48 w-48 md:h-56 bg-theme-primary dark:bg-theme-dark-primary rounded-full md:rounded-md shadow-lg;
  }
  .author-card img {
    @apply rounded-full h-48 w-48 md:h-56;
  }
</style>
