---
export const prerender = true;

import DefaultPageLayout from "$/layouts/default.astro";
import Hero from "../components/Hero.astro";
---

<Hero />

<DefaultPageLayout
  content={{
    title: "Multidisciplinary Designer, Animator & 3D Artist",
    description: "Blending creativity with strategic design to inspire and engage audiences.",
  }}
  showPageHeader={false}
>
  <div class="hero">
    <div class="hero__face">
      <div class="author-card">
        <img src="/images/lineart.svg" alt="Dean Yeager" title="Dean Yeager" />
      </div>
    </div>
    <div class="hero__says">
      <h1 class="text-2xl md:text-4xl font-semibold mb-4 text-theme-primary">
        Hello &#38; Welcome&#33;
      </h1>
      <p class="text-base md:text-lg text-theme-secondary">
        I&apos;m Dean Yeager, a multidisciplinary designer, animator, and 3D artist creating digital experiences for brands, businesses, and creative projects. My work blends design, motion, interactive media, and real-time 3D to turn ideas into polished visuals that feel clear, engaging, and memorable. Whether it&apos;s a website, animation, immersive environment, or visual campaign, I help clients bring their message to life with craft, creativity, and practical production experience.
        <br><br>
        Have a project in mind? Let&apos;s turn it into a visual experience.
      </p>
    </div>
  </div>
</DefaultPageLayout>

<style>
  .hero {
    @apply flex flex-col md:flex-row gap-8 w-full transition-all pb-4;
  }
  .hero__face {
    @apply flex md:flex-none justify-center;
  }
  .hero__says {
    @apply flex-1 text-center md:text-left;
  }
  .author-card {
    @apply h-48 w-48 md:h-56 bg-theme-primary dark:bg-theme-dark-primary rounded-full md:rounded-md shadow-lg;
  }
  .author-card img {
    @apply rounded-full h-48 w-48 md:h-56;
  }
</style>
