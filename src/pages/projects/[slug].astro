---
import { projects } from "../../data/projects.js";
import DefaultPageLayout from "$/layouts/default.astro";
import LightGalleryWrapper from "$/components/LightGalleryWrapper.svelte";

// Generate static paths for all projects
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// Get the project from props passed via getStaticPaths
const { project } = Astro.props as { project: (typeof projects)[number] };

// Fallback safety check (shouldn't be needed with getStaticPaths)
if (!project) {
  throw new Error(`Project not found`);
}

const items = project.gallery.map((g) => {
  if (typeof g === "string") {
    return { src: g, thumb: g };
  }
  const vimeoId = g.src.split("/").pop();
  return {
    src: `https://player.vimeo.com/video/${vimeoId}`,
    thumb: g.poster,
    video: {
      source: [
        {
          src: `https://player.vimeo.com/video/${vimeoId}`,
          type: "text/html",
        },
      ],
      attributes: {
        preload: false,
        controls: true,
      },
    },
  };
});
---

<DefaultPageLayout
  content={{
    title: project?.title,
    description: project?.description,
    image: project?.thumbnail,
    permalink: `/projects/${project?.slug}/`,
  }}
  showPageHeader={false}
>
  <!-- Add preload links for LightGallery CSS -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/css/lightgallery.css"
    crossorigin
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/css/lg-zoom.css"
    crossorigin
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/css/lg-thumbnail.css"
    crossorigin
  />

  <section class="px-4 py-12 max-w-5xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">{project.title}</h1>
    <p class="text-xl text-gray-500 mb-8">{project.type}</p>

    <!-- LightGallery container -->
    <LightGalleryWrapper items={items} title={project.title} client:load />
  </section>

  <style>
    /* Include some base LightGallery CSS inline */
    :global(.lg-backdrop) {
      background-color: rgba(0, 0, 0, 0.85);
    }

    :global(.lg-toolbar .lg-icon),
    :global(.lg-prev),
    :global(.lg-next) {
      color: rgba(255, 255, 255, 0.85) !important;
      opacity: 1 !important;
    }

    :global(.lg-icon) {
      font-family: "lg" !important;
      font-style: normal !important;
      font-weight: normal !important;
      font-variant: normal !important;
      text-transform: none !important;
      line-height: 1 !important;
      display: inline-block !important;
    }

    /* Your original styles */
    .overflow-y-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .overflow-y-scroll::-webkit-scrollbar-thumb {
      background: #999;
      border-radius: 3px;
    }
    .overflow-y-scroll::-webkit-scrollbar-track {
      background: transparent;
    }
  </style>
  {
    project.url && (
      <div class="mt-8 text-center">
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-orange-600 hover:bg-orange-700 text-white font-semibold py-3 px-6 rounded-lg transition"
        >
          View Live Site
        </a>
      </div>
    )
  }
</DefaultPageLayout>
